RewriteEngine On
# About this file:
# This .htaccess file is used to configure URL redirection and rewriting rules for the server.
# It includes rules to enforce HTTPS, redirect from www to non-www, and route requests to a specific subfolder.
# Make sure to replace 'subfolder' with the actual folder name where your application is located.
# Usage:
# Place this .htaccess file in the root directory of your website.
# ---------------------------------------------------------
# 1️⃣ Force HTTPS
# ---------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------
# 2️⃣ Force non-www (if you prefer www, invert this section)
# ---------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------
# 3️⃣ Redirect root domain to subfolder
# ---------------------------------------------------------
# Replace 'subfolder' with your actual folder name
RewriteCond %{HTTP_HOST} ^(stanthonygbaja\.org)$ [NC]
RewriteCond %{REQUEST_URI} !^/dist/
RewriteRule ^(.*)$ /dist/$1 [L]
# End of .htaccess file
# ---------------------------------------------------------