# ─────────────────────────────────────────────────────────────
# Production build template for St. Anthony Catholic Church, Gbaja.
# Copy to .env.production (or set in CI) before `yarn build`.
# Every VITE_* value is embedded in the public JavaScript bundle —
# never put secrets in VITE_* variables.
# ─────────────────────────────────────────────────────────────

# Backend API (baked into the bundle at build time)
VITE_API_BASE_URL=https://api.stanthonygbaja.org/api

# Chatbot: production builds ignore OpenAI keys and use rule-based answers
VITE_CHATBOT_ENABLED=true

# ── SEO / site identity ──
VITE_SITE_URL=https://stanthonygbaja.org
VITE_PARISH_EMAIL=info@stanthonygbaja.org
VITE_PARISH_PHONE=
VITE_PARISH_STREET_ADDRESS=
VITE_PARISH_POSTAL_CODE=
VITE_PARISH_LATITUDE=
VITE_PARISH_LONGITUDE=
VITE_PARISH_DIOCESE=Catholic Archdiocese of Lagos

# Social sharing image — use a 1200×630 parish photo when available
VITE_DEFAULT_OG_IMAGE=/og-image.png
VITE_DEFAULT_OG_IMAGE_WIDTH=1200
VITE_DEFAULT_OG_IMAGE_HEIGHT=630

VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_YOUTUBE=
# TikTok & X — leave blank until accounts are created and verified
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_TWITTER=
# Parish WhatsApp group invite, e.g. https://chat.whatsapp.com/XXXX
VITE_SOCIAL_WHATSAPP=
# Comma-separated, VERIFIED official profile URLs for schema.org sameAs
VITE_SAME_AS=
VITE_TWITTER_HANDLE=

# Search Console / Analytics (build-time head injection)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_GA_MEASUREMENT_ID=

# Build-only: public API used to add news, gallery, events and bulletins to sitemap.xml
SEO_SITEMAP_API_URL=https://api.stanthonygbaja.org/api
