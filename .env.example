# ─────────────────────────────────────────────────────────────
# IMPORTANT: every VITE_* variable is embedded in the public JavaScript
# bundle. Never put secrets (API keys, passwords) in VITE_* variables.
# ─────────────────────────────────────────────────────────────

# Backend API
VITE_API_BASE_URL=http://localhost:8000/api

# OpenAI — DEVELOPMENT ONLY. Production builds ignore this value and the
# chatbot uses its built-in rule-based answers. For AI answers in production,
# proxy requests through the backend and keep the key server-side.
VITE_OPENAI_API_KEY=your_openai_api_key_here
VITE_CHATBOT_ENABLED=true

# ── SEO / site identity (src/config/siteConfig.ts) ──
# Canonical origin, no trailing slash
VITE_SITE_URL=https://stanthonygbaja.org
# Optional, verified parish facts. Leave blank until confirmed — blank values are
# omitted from the page and from structured data (never shown as placeholders).
VITE_PARISH_EMAIL=info@stanthonygbaja.org
VITE_PARISH_PHONE=
VITE_PARISH_STREET_ADDRESS=
VITE_PARISH_POSTAL_CODE=
VITE_PARISH_LATITUDE=
VITE_PARISH_LONGITUDE=
VITE_PARISH_DIOCESE=
# Social sharing image (ideally a 1200×630 photo of the church)
VITE_DEFAULT_OG_IMAGE=/og-image.png
VITE_DEFAULT_OG_IMAGE_WIDTH=1200
VITE_DEFAULT_OG_IMAGE_HEIGHT=630
# Social profile links shown in the UI
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_YOUTUBE=
# TikTok & X — leave blank until accounts are created and verified
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_TWITTER=
# Parish WhatsApp group invite (preferred) or chat link, e.g. https://chat.whatsapp.com/XXXX or https://wa.me/234XXXXXXXXXX
VITE_SOCIAL_WHATSAPP=
# Comma-separated, VERIFIED official profile URLs for schema.org sameAs
VITE_SAME_AS=
VITE_TWITTER_HANDLE=

# ── Search Console / Analytics (build-time, injected into <head>) ──
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
# GA4 measurement ID (G-XXXXXXX). Leave blank to ship no tracking.
VITE_GA_MEASUREMENT_ID=

# Build-only (not exposed to the browser): public API used to add news,
# gallery albums, events and bulletins to sitemap.xml
# e.g. https://api.stanthonygbaja.org/api
SEO_SITEMAP_API_URL=
